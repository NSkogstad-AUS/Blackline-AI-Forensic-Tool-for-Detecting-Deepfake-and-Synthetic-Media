# Copy this file to `.env` (next to docker-compose.yml) and fill in secrets.
# Docker Compose will auto-load `.env` and inject values into services.
# Do NOT commit your real secrets.

# --- App/JWT ---
BL_JWT_SECRET=dev-secret-change-me

# --- Database (service: postgres) ---
# Default is set in compose; override here only if you change credentials or DB name.
DATABASE_URL=postgresql+psycopg2://blackline:blackline@postgres:5432/blackline

# --- Storage backend ---
# Use 's3' to enable presigned uploads to AWS S3, or 'local' to store on the api volume.
STORAGE_BACKEND=local

# If STORAGE_BACKEND=s3, set these:
STORAGE_BUCKET=your-bucket-name
AWS_REGION=us-east-1
# Optional path prefix inside the bucket, e.g., 'blackline/'. Leave blank for none.
STORAGE_PREFIX=
# AWS credentials for the backend container to sign presigned URLs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only if using temporary credentials (STS)
AWS_SESSION_TOKEN=

# Optional logging tweaks
STORAGE_BACKEND_LOG_LEVEL=
