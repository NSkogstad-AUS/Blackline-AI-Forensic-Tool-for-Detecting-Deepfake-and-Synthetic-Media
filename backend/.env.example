# Local development defaults for backend
# Copy to backend/.env and adjust as needed

# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://blackline:blackline@localhost:5432/blackline

# JWT signing secret (change for your machine)
BL_JWT_SECRET=dev-super-secret-change-me

# Storage backend: keep 'local' for dev to serve files from backend/data
STORAGE_BACKEND=local

# S3 configuration (only used when STORAGE_BACKEND=s3)
# STORAGE_BUCKET=blackline-dev
# AWS_REGION=us-east-1
# STORAGE_PREFIX=uploads/
# STORAGE_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Data root (where uploads/raw/derived live)
DATA_ROOT=backend/data

# --- Debug Admin (for development only) ---
# Create/maintain a persistent Admin user on startup. Disable in prod.
BL_ENABLE_DEBUG_ADMIN=1
BL_DEBUG_ADMIN_USER=admin
BL_DEBUG_ADMIN_EMAIL=admin@local
BL_DEBUG_ADMIN_PASSWORD=admin
